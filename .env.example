# Canonical public HTTPS origin. The current production target uses www.
SITE_URL=https://www.nofarkapury.co.il/
# Keep false in Cloudflare until DNS, redirects, legal-page URLs and HTTPS pass production checks.
# Change to true and redeploy only when the custom domain is ready for Google.
SITE_INDEXABLE=false

# Optional override for src/config/site.ts. Explicitly empty disables analytics.
VITE_GA_MEASUREMENT_ID=G-MENXJSNJ8Y
# Exact production hostnames only; preview deployments and localhost stay excluded.
VITE_GA_ALLOWED_HOSTS=www.nofarkapury.co.il,nofarkapury.co.il
